#!/usr/bin/env python3
"""Run the versioned reference-runtime conformance manifest."""

from __future__ import annotations

import argparse
import json
import os
import platform
import subprocess
import sys
import time
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parents[1]
MANIFEST_PATH = ROOT / "conformance/runtime-manifest-v1.json"
REGISTRY_PATH = ROOT / "conformance/protocol-rules-v1.json"
OUTPUT_VERSION = 1


class ContractError(Exception):
    def __init__(self, code: str, message: str) -> None:
        super().__init__(message)
        self.code = code


def read_json(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise ContractError(
            "ERROR_CONFORMANCE_CONFIG",
            f"cannot read conformance configuration {path}: {error}",
        ) from error
    if not isinstance(value, dict):
        raise ContractError(
            "ERROR_CONFORMANCE_CONFIG",
            f"conformance configuration must be a JSON object: {path}",
        )
    return value


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Run versioned SDD reference-runtime conformance cases.",
    )
    parser.add_argument(
        "--rule",
        action="append",
        default=[],
        metavar="RULE_ID",
        help="run cases mapped to this rule; repeatable",
    )
    parser.add_argument(
        "--case",
        action="append",
        default=[],
        dest="case_ids",
        metavar="CASE_ID",
        help="run this exact case; repeatable",
    )
    parser.add_argument(
        "--timeout-seconds",
        type=float,
        default=120.0,
        help="per-case timeout (default: 120)",
    )
    parser.add_argument("--fail-fast", action="store_true")
    parser.add_argument("--list", action="store_true", dest="list_only")
    parser.add_argument("--json", action="store_true", dest="json_output")
    return parser


def validate_and_select(
    manifest: dict[str, Any],
    registry: dict[str, Any],
    requested_rules: list[str],
    requested_cases: list[str],
) -> list[dict[str, Any]]:
    if manifest.get("manifest_version") != 1:
        raise ContractError(
            "ERROR_UNSUPPORTED_MANIFEST",
            f"unsupported runtime manifest version: {manifest.get('manifest_version')!r}",
        )
    if registry.get("registry_version") != 1:
        raise ContractError(
            "ERROR_UNSUPPORTED_REGISTRY",
            f"unsupported rule registry version: {registry.get('registry_version')!r}",
        )
    rules = registry.get("rules")
    cases = manifest.get("cases")
    if not isinstance(rules, list) or not isinstance(cases, list):
        raise ContractError(
            "ERROR_CONFORMANCE_CONFIG",
            "registry rules and manifest cases must be arrays",
        )

    known_rules = {
        rule.get("id")
        for rule in rules
        if isinstance(rule, dict) and isinstance(rule.get("id"), str)
    }
    known_cases = {
        case.get("id")
        for case in cases
        if isinstance(case, dict) and isinstance(case.get("id"), str)
    }
    unknown_rules = sorted(set(requested_rules) - known_rules)
    if unknown_rules:
        raise ContractError(
            "ERROR_UNKNOWN_RULE",
            f"unknown protocol rule(s): {', '.join(unknown_rules)}",
        )
    unknown_cases = sorted(set(requested_cases) - known_cases)
    if unknown_cases:
        raise ContractError(
            "ERROR_UNKNOWN_CASE",
            f"unknown conformance case(s): {', '.join(unknown_cases)}",
        )

    selected: list[dict[str, Any]] = []
    for case in cases:
        if not isinstance(case, dict):
            raise ContractError(
                "ERROR_CONFORMANCE_CONFIG",
                "each conformance case must be an object",
            )
        case_id = case.get("id")
        case_rules = case.get("rules")
        if not isinstance(case_id, str) or not isinstance(case_rules, list):
            raise ContractError(
                "ERROR_CONFORMANCE_CONFIG",
                "each conformance case requires string id and rules array",
            )
        if requested_rules and not set(requested_rules).intersection(case_rules):
            continue
        if requested_cases and case_id not in requested_cases:
            continue
        selected.append(case)
    if not selected:
        raise ContractError(
            "ERROR_EMPTY_SELECTION",
            "the requested filters select no conformance cases",
        )
    return selected


def command_for(case: dict[str, Any]) -> list[str]:
    kind = case.get("kind")
    if kind == "unittest":
        selectors = case.get("selectors")
        if not isinstance(selectors, list) or not all(
            isinstance(selector, str) for selector in selectors
        ):
            raise ContractError(
                "ERROR_CONFORMANCE_CONFIG",
                f"unittest case {case.get('id')} has invalid selectors",
            )
        return [sys.executable, "-m", "unittest", "-v", *selectors]
    if kind == "command":
        argv = case.get("argv")
        if not isinstance(argv, list) or not all(
            isinstance(argument, str) for argument in argv
        ):
            raise ContractError(
                "ERROR_CONFORMANCE_CONFIG",
                f"command case {case.get('id')} has invalid argv",
            )
        system = platform.system()
        if system == "Darwin":
            platform_name = "macos"
        elif system == "Linux":
            platform_name = "linux"
        else:
            raise ContractError(
                "ERROR_UNSUPPORTED_PLATFORM",
                f"runtime conformance is unsupported on {system or 'unknown platform'}",
            )
        replacements = {
            "{python}": sys.executable,
            "{platform}": platform_name,
        }
        return [replacements.get(argument, argument) for argument in argv]
    raise ContractError(
        "ERROR_CONFORMANCE_CONFIG",
        f"case {case.get('id')} has unsupported kind {kind!r}",
    )


def run_case(case: dict[str, Any], timeout_seconds: float) -> dict[str, Any]:
    argv = command_for(case)
    started = time.monotonic()
    environment = os.environ.copy()
    environment["PYTHONDONTWRITEBYTECODE"] = "1"
    environment["PYTHONUTF8"] = "1"
    try:
        completed = subprocess.run(
            argv,
            cwd=ROOT,
            env=environment,
            text=True,
            capture_output=True,
            timeout=timeout_seconds,
            check=False,
        )
        exit_code = completed.returncode
        stdout = completed.stdout
        stderr = completed.stderr
        timed_out = False
    except subprocess.TimeoutExpired as error:
        exit_code = 124
        stdout = error.stdout or ""
        stderr = error.stderr or ""
        if isinstance(stdout, bytes):
            stdout = stdout.decode("utf-8", errors="replace")
        if isinstance(stderr, bytes):
            stderr = stderr.decode("utf-8", errors="replace")
        stderr += f"\nconformance case timed out after {timeout_seconds:g} seconds\n"
        timed_out = True
    duration_ms = round((time.monotonic() - started) * 1000)
    return {
        "case_id": case["id"],
        "rules": case["rules"],
        "kind": case["kind"],
        "argv": argv,
        "exit_code": exit_code,
        "duration_ms": duration_ms,
        "timed_out": timed_out,
        "passed": exit_code == 0,
        "stdout": stdout,
        "stderr": stderr,
    }


def emit_error(error: ContractError, json_output: bool) -> int:
    document = {
        "output_version": OUTPUT_VERSION,
        "ok": False,
        "errors": [{"code": error.code, "message": str(error)}],
    }
    if json_output:
        print(json.dumps(document, ensure_ascii=False, sort_keys=True))
    else:
        print(f"{error.code}: {error}", file=sys.stderr)
    return 2


def main(argv: list[str] | None = None) -> int:
    arguments = build_parser().parse_args(argv)
    if arguments.timeout_seconds <= 0:
        return emit_error(
            ContractError(
                "ERROR_INVALID_TIMEOUT",
                "--timeout-seconds must be greater than zero",
            ),
            arguments.json_output,
        )
    try:
        registry = read_json(REGISTRY_PATH)
        manifest = read_json(MANIFEST_PATH)
        selected = validate_and_select(
            manifest,
            registry,
            arguments.rule,
            arguments.case_ids,
        )
        inventory = [
            {
                "case_id": case["id"],
                "kind": case["kind"],
                "rules": case["rules"],
            }
            for case in selected
        ]
        if arguments.list_only:
            document = {
                "output_version": OUTPUT_VERSION,
                "ok": True,
                "mode": "list",
                "manifest_version": manifest["manifest_version"],
                "registry_version": registry["registry_version"],
                "cases": inventory,
            }
            if arguments.json_output:
                print(json.dumps(document, ensure_ascii=False, sort_keys=True))
            else:
                for case in inventory:
                    print(
                        f"{case['case_id']}: {', '.join(case['rules'])}"
                    )
            return 0

        results: list[dict[str, Any]] = []
        for case in selected:
            result = run_case(case, arguments.timeout_seconds)
            results.append(result)
            if not arguments.json_output:
                label = "PASS" if result["passed"] else "FAIL"
                print(
                    f"[{label}] {result['case_id']} "
                    f"({', '.join(result['rules'])})"
                )
                if not result["passed"] and result["stderr"]:
                    print(result["stderr"], file=sys.stderr, end="")
            if arguments.fail_fast and not result["passed"]:
                break
    except ContractError as error:
        return emit_error(error, arguments.json_output)

    ok = all(result["passed"] for result in results)
    document = {
        "output_version": OUTPUT_VERSION,
        "ok": ok,
        "mode": "run",
        "manifest_version": manifest["manifest_version"],
        "registry_version": registry["registry_version"],
        "selected_rules": sorted(set(arguments.rule)),
        "selected_cases": [result["case_id"] for result in results],
        "results": results,
    }
    if arguments.json_output:
        print(json.dumps(document, ensure_ascii=False, sort_keys=True))
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main())
