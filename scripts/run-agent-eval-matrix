#!/usr/bin/env python3
"""Run the minimum versioned Agent/scenario eval matrix with safe retries."""

from __future__ import annotations

import argparse
import concurrent.futures
import json
import os
import subprocess
import sys
import threading
from pathlib import Path
from typing import Any

from agent_eval_scoring import (
    EVAL_SPEC_PATH,
    ROOT,
    aggregate_summary,
    identity_mismatches,
    read_json,
    scenario_paths,
)
from agent_eval_lib import SKILL, git_head, sha256


RUNNER = ROOT / "scripts/run-agent-eval"
SCORER = ROOT / "scripts/score-agent-eval"


def emit(value: dict[str, Any]) -> None:
    print(json.dumps(value, ensure_ascii=False, sort_keys=True), flush=True)


def existing_valid_count(
    root: Path,
    agent: str,
    scenario_id: str,
    expected_identity: dict[str, Any],
) -> int:
    count = 0
    for path in root.glob(f"{agent}/{scenario_id}/*/score.json"):
        try:
            score = read_json(path)
            metadata = read_json(path.parent / "run-metadata.json")
        except Exception:
            continue
        if (
            score.get("status") == "complete"
            and score.get("valid_run")
            and not identity_mismatches(metadata, expected_identity)
        ):
            count += 1
    return count


def invoke(argv: list[str]) -> subprocess.CompletedProcess[str]:
    environment = os.environ.copy()
    environment["PYTHONDONTWRITEBYTECODE"] = "1"
    return subprocess.run(
        argv,
        cwd=ROOT,
        env=environment,
        text=True,
        capture_output=True,
        check=False,
    )


def score_existing(run_directory: Path) -> dict[str, Any] | None:
    score_path = run_directory / "score.json"
    if not score_path.is_file():
        return None
    score = read_json(score_path)
    if score.get("status") == "complete":
        return score
    completed = invoke([sys.executable, str(SCORER), str(run_directory)])
    if completed.returncode != 0:
        return None
    return read_json(score_path)


def run_slot(
    *,
    artifact_root: Path,
    agent: str,
    model: str,
    scenario_id: str,
    slot: int,
    maximum_attempts: int,
    expected_identity: dict[str, Any],
    evaluation_mode: str,
    stop_event: threading.Event,
) -> dict[str, Any]:
    if stop_event.is_set():
        return {
            "agent": agent,
            "scenario_id": scenario_id,
            "slot": slot,
            "result": "skipped_after_critical",
            "attempts": [],
        }
    replaces: str | None = None
    attempts: list[dict[str, Any]] = []
    for attempt in range(1, maximum_attempts + 1):
        if stop_event.is_set():
            return {
                "agent": agent,
                "scenario_id": scenario_id,
                "slot": slot,
                "result": "skipped_after_critical",
                "attempts": attempts,
            }
        run_id = (
            f"{evaluation_mode}-{agent}-{scenario_id.lower()}-"
            f"slot-{slot}-attempt-{attempt}"
        )
        run_directory = artifact_root / agent / scenario_id / run_id
        if run_directory.exists():
            score = score_existing(run_directory)
            try:
                metadata = read_json(run_directory / "run-metadata.json")
            except Exception:
                metadata = {}
            mismatches = identity_mismatches(metadata, expected_identity)
            if score and not mismatches and score.get("critical_violation"):
                stop_event.set()
            if score and not mismatches and score.get("valid_run"):
                return {
                    "agent": agent,
                    "scenario_id": scenario_id,
                    "slot": slot,
                    "result": "existing_valid",
                    "run_id": run_id,
                    "adherent": bool(score.get("adherent")),
                    "critical_violation": bool(score.get("critical_violation")),
                    "attempts": attempts,
                }
            if score and not mismatches and score.get("critical_violation"):
                return {
                    "agent": agent,
                    "scenario_id": scenario_id,
                    "slot": slot,
                    "result": "existing_critical_invalid",
                    "run_id": run_id,
                    "attempts": attempts,
                }
            replaces = run_id
            attempts.append(
                {
                    "run_id": run_id,
                    "result": (
                        "existing_identity_mismatch"
                        if mismatches
                        else "existing_invalid"
                    ),
                }
            )
            continue

        argv = [
            sys.executable,
            str(RUNNER),
            "--agent",
            agent,
            "--scenario",
            scenario_id,
            "--model",
            model,
            "--run-id",
            run_id,
            "--artifact-root",
            str(artifact_root),
        ]
        if replaces:
            argv.extend(["--replaces-run-id", replaces])
        run = invoke(argv)
        if not run_directory.exists():
            attempts.append(
                {
                    "run_id": run_id,
                    "result": "harness_no_artifact",
                    "exit_code": run.returncode,
                    "stderr": run.stderr[-500:],
                }
            )
            replaces = run_id
            continue
        scored = invoke([sys.executable, str(SCORER), str(run_directory)])
        if scored.returncode != 0:
            attempts.append(
                {
                    "run_id": run_id,
                    "result": "scorer_error",
                    "exit_code": scored.returncode,
                    "stderr": scored.stderr[-500:],
                }
            )
            replaces = run_id
            continue
        score = read_json(run_directory / "score.json")
        attempts.append(
            {
                "run_id": run_id,
                "result": "valid" if score.get("valid_run") else "invalid",
                "invalid_reasons": score.get("invalid_reasons", []),
            }
        )
        if score.get("critical_violation"):
            stop_event.set()
        if score.get("valid_run"):
            return {
                "agent": agent,
                "scenario_id": scenario_id,
                "slot": slot,
                "result": "valid",
                "run_id": run_id,
                "adherent": bool(score.get("adherent")),
                "critical_violation": bool(score.get("critical_violation")),
                "attempts": attempts,
            }
        if score.get("critical_violation"):
            return {
                "agent": agent,
                "scenario_id": scenario_id,
                "slot": slot,
                "result": "critical_invalid",
                "run_id": run_id,
                "attempts": attempts,
            }
        replaces = run_id
    return {
        "agent": agent,
        "scenario_id": scenario_id,
        "slot": slot,
        "result": "attempts_exhausted",
        "attempts": attempts,
    }


def parser() -> argparse.ArgumentParser:
    value = argparse.ArgumentParser(description=__doc__)
    value.add_argument(
        "--artifact-root",
        type=Path,
        default=ROOT / "eval-runs/v07-baseline",
    )
    value.add_argument("--codex-model", default="gpt-5.6-sol")
    value.add_argument("--claude-model", default="sonnet")
    value.add_argument("--jobs", type=int, default=2)
    selection = value.add_mutually_exclusive_group(required=True)
    selection.add_argument("--scenario", action="append", dest="scenarios")
    selection.add_argument("--full-benchmark", action="store_true")
    value.add_argument("--dry-run", action="store_true")
    return value


def main(argv: list[str] | None = None) -> int:
    argument_parser = parser()
    arguments = argument_parser.parse_args(argv)
    if arguments.jobs < 1:
        argument_parser.error("--jobs must be at least 1")
    known_scenarios = scenario_paths()
    selected_scenarios = (
        sorted(known_scenarios)
        if arguments.full_benchmark
        else arguments.scenarios
    )
    if len(selected_scenarios) != len(set(selected_scenarios)):
        argument_parser.error("--scenario values must be unique")
    unknown = sorted(set(selected_scenarios) - set(known_scenarios))
    if unknown:
        argument_parser.error(f"unknown scenarios: {', '.join(unknown)}")
    spec = read_json(EVAL_SPEC_PATH)
    maximum_attempts = spec["run_policy"]["rerun"]["maximum_attempts_per_planned_run"]
    models = {
        "codex": arguments.codex_model,
        "claude": arguments.claude_model,
    }
    evaluation_mode = (
        "full_benchmark" if arguments.full_benchmark else "affected_release"
    )
    required = (
        spec["full_benchmark"]["valid_runs_per_cell"]
        if arguments.full_benchmark
        else spec["release_selection"]["valid_adherent_runs_per_cell"]
    )
    expected_identity = {
        "skill_commit": git_head(),
        "skill_sha256": sha256(SKILL),
        "eval_spec_version": spec["eval_spec_version"],
        "eval_spec_sha256": sha256(EVAL_SPEC_PATH),
        "models": models,
    }
    artifact_root = arguments.artifact_root.resolve()
    jobs: list[dict[str, Any]] = []
    stop_event = threading.Event()
    for agent, model in models.items():
        for scenario_id in selected_scenarios:
            existing = existing_valid_count(
                artifact_root,
                agent,
                scenario_id,
                expected_identity,
            )
            for slot in range(existing + 1, required + 1):
                jobs.append(
                    {
                        "artifact_root": artifact_root,
                        "agent": agent,
                        "model": model,
                        "scenario_id": scenario_id,
                        "slot": slot,
                        "maximum_attempts": maximum_attempts,
                        "expected_identity": expected_identity,
                        "evaluation_mode": evaluation_mode,
                        "stop_event": stop_event,
                    }
                )
    if arguments.dry_run:
        emit(
            {
                "ok": True,
                "evaluation_mode": evaluation_mode,
                "selected_scenarios": selected_scenarios,
                "scheduled_slots": len(jobs),
                "expected_identity": expected_identity,
            }
        )
        return 0
    artifact_root.mkdir(parents=True, exist_ok=True)
    emit(
        {
            "event": "matrix_started",
            "artifact_root": str(artifact_root),
            "evaluation_mode": evaluation_mode,
            "selected_scenarios": selected_scenarios,
            "scheduled_slots": len(jobs),
            "jobs": arguments.jobs,
            "expected_identity": expected_identity,
        }
    )
    results: list[dict[str, Any]] = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=arguments.jobs) as pool:
        futures = [pool.submit(run_slot, **job) for job in jobs]
        for future in concurrent.futures.as_completed(futures):
            result = future.result()
            results.append(result)
            emit({"event": "slot_completed", **result})
    summary = aggregate_summary(
        artifact_root,
        selected_scenarios=selected_scenarios,
        expected_identity=expected_identity,
        evaluation_mode=evaluation_mode,
    )
    emit(
        {
            "event": "matrix_completed",
            "scheduled_slots": len(jobs),
            "completed_slots": sum(
                result["result"] in {"valid", "existing_valid"}
                for result in results
            ),
            "summary": summary,
        }
    )
    return 0 if summary["evaluation_pass"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
